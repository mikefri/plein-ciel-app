{
  "expo": {
    "name": "Plein Ciel",
    "slug": "plein-ciel",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#1470c8"
    },
    "android": {
      "package": "com.mikefri.pleinciel",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1470c8"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1470c8"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2c3f7dea-8add-4f80-80a9-54aa114606cb"
      }
    },
    "owner": "micfri58"
  }
}
