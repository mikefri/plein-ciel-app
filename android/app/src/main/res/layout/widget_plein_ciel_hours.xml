<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root2"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#E61470C8"
    android:padding="10dp">
    <TextView android:id="@+id/widget_city2" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Paris" android:textColor="#DFFEFF" android:textSize="13sp"/>
    <ImageView android:id="@+id/widget_chart" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitCenter" android:layout_marginTop="4dp"/>
</LinearLayout>
